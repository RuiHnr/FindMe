CREATE TABLE identity_pin(
    user_id TEXT NOT NULL PRIMARY KEY,
    identity_key_dh TEXT NOT NULL,
    identity_key_sign TEXT NOT NULL,
    first_seen_at INTEGER NOT NULL,
    last_verified_at INTEGER NOT NULL,
    is_trusted INTEGER NOT NULL DEFAULT 1
);

-- Queries

getPin:
SELECT * FROM identity_pin WHERE user_id = :userId;

upsertPin:
INSERT OR REPLACE INTO identity_pin (
    user_id,
    identity_key_dh,
    identity_key_sign,
    first_seen_at,
    last_verified_at,
    is_trusted
    )
VALUES (?, ?, ?, ?, ?, ?);

updateTrustStatus:
UPDATE identity_pin
SET is_trusted = :isTrusted, last_verified_at = :lastVerifiedAt
WHERE user_id = :userId;

deletePin:
DELETE FROM identity_pin WHERE user_id = :userId;